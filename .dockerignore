# 设计原型与截图不进镜像
ui/
*.png
*.jpg

# 挂载点数据不进镜像
data/
config/

# 各种临时/本地文件
# .git 只放行「几 KB 的指针文件」（HEAD / refs / packed-refs / 描述文件），
# 供 Dockerfile 的 gitinfo 阶段解析出提交号 —— 于是 docker compose up -d --build 零参数就能带上准确 commit。
# 历史对象、reflog、索引、hooks 以及可能含凭据的 .git/config 一律不进构建上下文。
.git/objects/
.git/logs/
.git/modules/
.git/hooks/
.git/index
.git/config
.git/COMMIT_EDITMSG
.git/FETCH_HEAD
.git/ORIG_HEAD
.git/MERGE_HEAD
.git/MERGE_MSG
.git/gc.log
.gitignore
**/.DS_Store
**/Thumbs.db
**/node_modules
**/_tmp_*
**/_dom.html
**/_inline.js
**/*.log
.env
.env.*
